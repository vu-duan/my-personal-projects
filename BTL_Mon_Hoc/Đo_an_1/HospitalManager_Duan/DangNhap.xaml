<Window x:Class="HospitalManager_Duan.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalManager_Duan"
        mc:Ignorable="d"
        Title="Đăng nhập" Height="400" Width="550" Background="#e6ffff" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="233" Margin="0,78,0,0" Stroke="Black" VerticalAlignment="Top" Width="466" Fill="#7cfc60"/>

        <Label Content="Email:" HorizontalAlignment="Left" Height="41" Margin="58,149,0,0" VerticalAlignment="Top" Width="90"/>
        <Label Content="Password:" HorizontalAlignment="Left" Height="32" Margin="48,200,0,0" VerticalAlignment="Top" Width="118"/>
        <Button Content="Đăng nhập" HorizontalAlignment="Left" Height="33" Margin="211,255,0,0" VerticalAlignment="Top" Width="179" Click="Button_Click"/>
        <TextBox x:Name="EmailAddressTextBox" HorizontalAlignment="Left" Height="30" Margin="165,151,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="300"/>
        <TextBox x:Name="MatKhauTextBox" HorizontalAlignment="Left" Height="30" Margin="165,202,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="300" RenderTransformOrigin="0.501,1.128"/>

        <!--Quên mật khẩu-->
        <TextBlock Margin="55,269,343,10">
    <Hyperlink Click="Hyperlink_Click">
        Quên mật khẩu?
    </Hyperlink>
        </TextBlock>

        <Label Content="Mời bạn đăng nhập để có thể sử dụng đầy đủ các tính năng " HorizontalAlignment="Left" Height="26" Margin="52,105,0,0" VerticalAlignment="Top" Width="368" FontSize="10" FontWeight="Medium" Foreground="Black" />

    </Grid>
</Window>
