<UserControl x:Class="HospitalManager_Duan.UC_QuanLyBenhNhan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HospitalManager_Duan"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400" Loaded="UserControl_Loaded">
    <Grid Background="#e6ffff">
        <Label Content="Tra cứu thông tin bệnh nhân" HorizontalAlignment="Left" Height="63" Margin="86,0,0,0" VerticalAlignment="Top" Width="566" FontSize="35"/>
        <DataGrid x:Name="QuanLyBenhNhanDataGridQ" HorizontalAlignment="Left" Height="194" Margin="10,271,0,0" VerticalAlignment="Top" Width="673" AutoGenerateColumns="False" SelectionChanged="QuanLyBenhNhanDataGridQ_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã bệnh nhân" Width="180" Binding="{Binding MaBenhNhan}"/>
                <DataGridTextColumn Header="Tên bệnh nhân" Width="200" Binding="{Binding TenBenhNhan}"/>
                <DataGridTextColumn Header="Năm sinh" Width="180" Binding="{Binding NamSinh}"/>
                <DataGridTextColumn Header="Giới tính" Width="180" Binding="{Binding GioiTinh}"/>
                <DataGridTextColumn Header="Địa chỉ" Width="180" Binding="{Binding DiaChi}"/>
                <DataGridTextColumn Header="Phone" Width="180" Binding="{Binding Phone}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="Mã bệnh nhân:" HorizontalAlignment="Left" Height="45" Margin="2,85,0,0" VerticalAlignment="Top" Width="161"/>

        <TextBox x:Name="CccdBNhanTxtQ" HorizontalAlignment="Left" Height="32" Margin="163,89,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="520"/>

        <Button x:Name="TraCuuBtnQ" Content="Tra cứu" HorizontalAlignment="Left" Height="45" Margin="163,175,0,0" VerticalAlignment="Top" Width="192" Click="TraCuuBtnQ_Click"/>
        <Button x:Name="LamTuoiBtnQ" Content="Làm tươi" HorizontalAlignment="Left" Height="45" Margin="473,175,0,0" VerticalAlignment="Top" Width="192" Click="LamTuoiBtnQ_Click"/>

        <Label Content="Thông Tin Bệnh Nhân" HorizontalAlignment="Left" Height="61" Margin="879,0,0,0" VerticalAlignment="Top" Width="446" FontSize="35"/>
        <Label Content="Mã bệnh nhân:" HorizontalAlignment="Left" Height="41" Margin="728,79,0,0" VerticalAlignment="Top" Width="155" Foreground="Black"/>
        <Label Content="Tên bệnh nhân:" HorizontalAlignment="Left" Height="44" Margin="720,148,0,0" VerticalAlignment="Top" Width="155" Foreground="Black"/>
        <Label Content="Năm sinh:" HorizontalAlignment="Left" Height="40" Margin="732,224,0,0" VerticalAlignment="Top" Width="113" Foreground="Black"/>
        <Label Content="Giới tính:" HorizontalAlignment="Left" Height="36" Margin="733,306,0,0" VerticalAlignment="Top" Width="118" Foreground="Black"/>
        <Label Content="Địa chỉ:" HorizontalAlignment="Left" Height="45" Margin="739,386,0,0" VerticalAlignment="Top" Width="106" Foreground="Black"/>
        <Label Content="Phone:" HorizontalAlignment="Left" Height="31" Margin="735,467,0,0" VerticalAlignment="Top" Width="106" Foreground="Black"/>
        
        <TextBox x:Name="MaBenhNhanTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,79,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>
        <TextBox x:Name="TenBenhNhanTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,152,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>
        <TextBox x:Name="NamSinhTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,228,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>
        <TextBox x:Name="GioiTinhTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,306,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>
        <TextBox x:Name="DiaChiTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,386,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>
        <TextBox x:Name="PhoneTxtQ" HorizontalAlignment="Left" Height="32" Margin="888,467,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="474"/>

    </Grid>
</UserControl>
