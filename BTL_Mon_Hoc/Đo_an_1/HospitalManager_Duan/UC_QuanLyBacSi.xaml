<UserControl x:Class="HospitalManager_Duan.UC_QuanLyBacSi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HospitalManager_Duan"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400" Loaded="UserControl_Loaded">
    <Grid Background="#e6ffff">
        <DataGrid x:Name="BacSiDataGridQLBS" HorizontalAlignment="Left" Height="333" Margin="10,62,0,0" VerticalAlignment="Top" Width="582"  AutoGenerateColumns="False" SelectionChanged="BacSiDataGridQLBS_SelectionChanged">
            <DataGrid.Columns>
                <!--Đang định nghĩa các cột của table: với tên gọi và độ rộng của ta -->
                <DataGridTextColumn Header="MaKhoa" Width="135" Binding="{Binding MaKhoa}"/>
                <DataGridTextColumn Header="MaBacSi" Width="180" Binding="{Binding MaBacSi}"/>
                <DataGridTextColumn Header="TenBacSi" Width="200" Binding="{Binding TenBacSi}"/>
                <DataGridTextColumn Header="NamSinh" Width="160" Binding="{Binding NamSinh}"/>
                <DataGridTextColumn Header="Phone" Width="160" Binding="{Binding Phone}"/>
                <DataGridTextColumn Header="GioiTinh" Width="110" Binding="{Binding GioiTinh}"/>
                <DataGridTextColumn Header="ChucVu" Width="260" Binding="{Binding ChucVu}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Mã Khoa:" HorizontalAlignment="Left" Margin="630,22,0,0" VerticalAlignment="Top" Foreground="Black"/>
        <Label Content="Bác sĩ ID:" HorizontalAlignment="Left" Height="41" Margin="630,81,0,0" VerticalAlignment="Top" Width="100" Foreground="Black"/>
        <Label Content="Tên Bác sĩ:" HorizontalAlignment="Left" Height="34" Margin="628,151,0,0" VerticalAlignment="Top" Width="113" Foreground="Black"/>
        <Label Content="Năm sinh:" HorizontalAlignment="Left" Height="40" Margin="630,224,0,0" VerticalAlignment="Top" Width="113" Foreground="Black"/>
        <Label Content="Phone:" HorizontalAlignment="Left" Height="36" Margin="634,298,0,0" VerticalAlignment="Top" Width="86" Foreground="Black"/>
        <Label Content="Giới tính:" HorizontalAlignment="Left" Height="33" Margin="632,374,0,0" VerticalAlignment="Top" Width="100" Foreground="Black"/>
        <Label Content="Chức vụ:" HorizontalAlignment="Left" Height="42" Margin="633,446,0,0" VerticalAlignment="Top" Width="96" Foreground="Black"/>
        
        <TextBox x:Name="MaKhoaTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,22,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="518" FontWeight="Normal"/>
        <TextBox x:Name="BacSiIdTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,86,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="518" FontWeight="Normal"/>
        <TextBox x:Name="TenBacSiTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,148,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontWeight="Normal"/>
        <TextBox x:Name="NamSinhTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,222,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontWeight="Normal"/>
        <TextBox x:Name="PhoneTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,302,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontWeight="Normal"/>
        <TextBox x:Name="GioiTinhTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,374,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontWeight="Normal"/>
        <TextBox x:Name="ChucVuTxtQLBs" HorizontalAlignment="Left" Height="32" Margin="765,443,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontWeight="Normal"/>

    </Grid>
</UserControl>
