<Application x:Class="HospitalManager_Duan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HospitalManager_Duan"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Lưu ý: TargetType là: Label, textbox, button,.....-->

        <!-- Label-->
        <!-- Mặc định Default Label Style: Cứ kéo Label ra màn hình thì theo định dạng này: Chữ vàng, nền trong suốt, chữ đậm, cỡ chữ 18 -->
        <Style TargetType="Label">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="blue"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 2nd Label Style(giành cho header của 1 cửa sổ): Cứ kéo Label ra màn hình thì theo định dạng này: Chữ vàng, nền màu nõn chuối, chữ đậm, cỡ chữ 40 -->
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <!--Đặt tên-->
            <Setter Property="Background" Value="#ffff00"/>
            <Setter Property="Foreground" Value="#ff0800"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Button-->
        <!-- Mặc định Default Button Style: Cứ kéo Label ra màn hình thì theo định dạng này: Chữ vàng, nền đỏ, chữ đậm, cỡ chữ 18 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#ffcccc"/>
            <Setter Property="Foreground" Value="#ffff00"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Textbox-->
        <!--Primary/ Default TextBox Style: Nền Đỏ Orange-Red, Chữ Vàng Đậm, Căn Chữ Giữa Ô, cỡ 18 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#f2f2f2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Application.Resources>
</Application>
