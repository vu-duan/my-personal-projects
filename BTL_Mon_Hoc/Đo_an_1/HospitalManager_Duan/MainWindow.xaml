<Window x:Class="HospitalManager_Duan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalManager_Duan"
        mc:Ignorable="d"
        Title="Bệnh Viện H" Height="790" Width="1400" WindowStartupLocation="CenterScreen" Background="#e6ffff" FontSize="25" FontWeight="Bold">

    <Grid>
        <!--
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>
        -->

        <Grid.RowDefinitions>

            <RowDefinition Height="61"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="601*"/>

        </Grid.RowDefinitions>


        <!-- Menu cấp cứu-->
        <Menu Grid.Row="0" Background="#ffffff" Foreground="Black" >

            <MenuItem Header="       Cấp cứu 1000 666 666      " FontSize="30" FontWeight="Bold" Height="65" Width="500" Foreground="red">
            </MenuItem>

            <MenuItem Header="            " FontSize="30" FontWeight="Bold" Height="65" Width="500" Foreground="red">
            </MenuItem>

            <MenuItem x:Name="Menu1_ĐangKy" Header="   Đăng ký" FontSize="30" FontWeight="Bold" Height="66" Width="180" Click="Menu1_ĐangKy_Click">
            </MenuItem>


            <MenuItem x:Name="Menu1_DangNhap" Header="  Đăng nhập  " FontSize="30" FontWeight="Bold" Height="66" Width="200" Click="Menu1_DangNhap_Click" >
            </MenuItem>


        </Menu>


        <!-- Menu Trang chủ  giới thiệu-->
        <!-- Grid.RowSpan="2"  -->
        <Menu Background=" #e6f2ff" Foreground="Blue" FontWeight="Bold" Height="76" VerticalAlignment="Top" Grid.Row="1" Margin="0,1,0,0" Grid.RowSpan="2">

            <MenuItem Header="   " FontSize="25" Height="44" Width="364">
            </MenuItem>

            <MenuItem Header="   Trang chủ " FontSize="25" Height="66" Width="170" Click="Menu2_TrangChu_Click">
            </MenuItem>

            <MenuItem Header="   Giới thiệu" FontSize="25" Height="65" Width="170" Click="Menu2_GioiThieu_Click">
            </MenuItem>

            <!-- 
            <MenuItem Header="   Dịch Vụ" FontSize="25" Height="70" Width="160" Click="Menu2_DichVu_Click">
            
            </MenuItem>
            -->
            <!-- Click="Menu2_ChuyenKhoa_Click"-->
            <MenuItem Header=" Chuyên khoa" FontSize="25" Height="66" Width="180" >
                <MenuItem Header="Khoa mắt" Click="KhoaMatMw_Click"/>
                <MenuItem Header="Khoa hô hấp" Click="KhoaHoHapMw_Click"/>
                <MenuItem Header="Khoa tim mạch" Click="KhoaTimMachMw_Click"/>
                <MenuItem Header="Khoa cấp cứu" Click="KhoaCapCuuMw_Click"/>
            </MenuItem>

            <MenuItem Header="   Tin tức" FontSize="25" Height="66" Width="150" Click="Menu2_TinTuc_Click">
            </MenuItem>

            <MenuItem Header="    Liên hệ" FontSize="25" Height="66" Width="160" Click="Menu2_LienHe_Click">
            </MenuItem>

        </Menu>




        <Label Content="     Trang chủ   " HorizontalAlignment="Center" Height="63" Grid.Row="2" VerticalAlignment="Center" Width="1396" x:Name="lblTrangChuMainWindow"  Background="#f0f5f5" RenderTransformOrigin="0.5,0.5" >
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.237"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>



        <!-- Nội dung  -->
        
        <!-- VÙNG HIỂN THỊ -->
        <ContentControl x:Name="MainContent"
                    Grid.Row="3" Margin="0,2,0,0"/>
        








    </Grid>

</Window>
