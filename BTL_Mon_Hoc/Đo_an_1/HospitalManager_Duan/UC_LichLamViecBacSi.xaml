<UserControl x:Class="HospitalManager_Duan.UC_LichLamViecBacSi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HospitalManager_Duan"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400" Loaded="UserControl_Loaded">
    <Grid Background="#e6ffff">
        <Label Content="Ngày làm việc:" HorizontalAlignment="Left" Height="42" Margin="197,43,0,0" VerticalAlignment="Top" Width="157"/>
        <TextBox x:Name="TKNgayKhamTxtL" HorizontalAlignment="Left" Height="32" Margin="426,43,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="596"/>
        <DataGrid x:Name="LichLamViecDataGirdL" HorizontalAlignment="Left" Height="190" Margin="39,188,0,0" VerticalAlignment="Top" Width="1319" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu" Width="175" Binding="{Binding MaPhieu}"/>
                <DataGridTextColumn Header="Mã bệnh nhân" Width="180" Binding="{Binding MaBenhNhan}"/>
                <DataGridTextColumn Header="Ngày khám" Width="180" Binding="{Binding NgayKham}"/>
                <DataGridTextColumn Header="Buổi khám" Width="165" Binding="{Binding Buoi}"/>
                <DataGridTextColumn Header="Triệu chứng" Width="300" Binding="{Binding TrieuChung}"/>
                <DataGridTextColumn Header="Tên khoa" Width="180" Binding="{Binding TenKhoa}"/>
                <DataGridTextColumn Header="Bác sĩ" Width="200" Binding="{Binding BacSi}"/>
                <DataGridTextColumn Header="Kết quả" Width="300" Binding="{Binding KetQua}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="TraCuuBtnLlv" Content="Tra Cứu" HorizontalAlignment="Left" Height="40" Margin="476,117,0,0" VerticalAlignment="Top" Width="181" Click="TraCuuBtnLlv_Click"/>
        <Button x:Name="LamTuoiBtnLlv" Content="Làm Tươi" HorizontalAlignment="Left" Height="40" Margin="765,115,0,0" VerticalAlignment="Top" Width="181" Click="LamTuoiBtnLlv_Click"/>
        <Label Content="(DD/MM/YYYY)" HorizontalAlignment="Left" Height="42" Margin="1046,41,0,0" VerticalAlignment="Top" Width="172" Foreground="red"/>

    </Grid>
</UserControl>
