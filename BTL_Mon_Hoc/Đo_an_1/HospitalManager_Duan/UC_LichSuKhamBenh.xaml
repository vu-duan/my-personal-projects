<UserControl x:Class="HospitalManager_Duan.UC_LichSuKhamBenh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HospitalManager_Duan"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400" Loaded="UserControl_Loaded">
    <Grid Background="#e6ffff">

        <!-- 
        <GroupBox Header="Tra cứu lịch sử khám khám bệnh" Margin="36,12,36,425" Background="#ffffe6" >
        </GroupBox>
        -->

        <TextBox HorizontalAlignment="Left" Height="32" Margin="222,44,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="478" x:Name="MaBNhanLSKBenhTK" FontWeight="Normal"/>

        <Label Content="Căn cước công dân:" HorizontalAlignment="Left" Height="42" Margin="18,41,0,0" VerticalAlignment="Top" Width="199" Foreground="Black"/>

        <DataGrid x:Name="LichSuKhamBenhDataGirdBN" HorizontalAlignment="Left" Height="304" Margin="18,189,0,0" VerticalAlignment="Top" Width="682" AutoGenerateColumns="False" SelectionChanged="LichSuKhamBenhDataGirdBN_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Phiếu" Width="120" Binding="{Binding MaPhieu}"/>
                <DataGridTextColumn Header="Mã Bệnh nhân" Width="180" Binding="{Binding MaBenhNhan}"/>
                <DataGridTextColumn Header="Ngày Khám" Width="150" Binding="{Binding NgayKham}"/>
                <DataGridTextColumn Header="Buổi" Width="90" Binding="{Binding Buoi}"/>
                <DataGridTextColumn Header="Tên Khoa" Width="200" Binding="{Binding TenKhoa}"/>
                <DataGridTextColumn Header="Triệu chứng" Width="200" Binding="{Binding TrieuChung}"/>
                <DataGridTextColumn Header="Bác sĩ" Width="180" Binding="{Binding BacSi}"/>
                <DataGridTextColumn Header="Kết quả" Width="200" Binding="{Binding KetQua}"/>

            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="BtnTkiemLSKBenh" Content="Tìm Kiếm" HorizontalAlignment="Left" Height="41" Margin="237,114,0,0" VerticalAlignment="Top" Width="151" Click="BtnTkiemLSKBenh_Click"/>

        <Button x:Name="BtnLamTuoiLSKBenh" Content="Làm tươi" HorizontalAlignment="Left" Height="41" Margin="519,114,0,0" VerticalAlignment="Top" Width="163" Click="BtnLamTuoiLSKBenh_Click"/>

        <Label Content="Mã phiếu:" HorizontalAlignment="Left" Height="40" Margin="757,2,0,0" VerticalAlignment="Top" Width="111" Foreground="Black"/>
        <Label Content="Mã bệnh nhân:" HorizontalAlignment="Left" Height="47" Margin="737,63,0,0" VerticalAlignment="Top" Width="159" Foreground="Black"/>
        <Label Content="Ngày khám:" HorizontalAlignment="Left" Height="34" Margin="751,121,0,0" VerticalAlignment="Top" Width="129" Foreground="Black"/>
        <Label Content="Buổi khám:" HorizontalAlignment="Left" Height="38" Margin="749,189,0,0" VerticalAlignment="Top" Width="129" Foreground="Black"/>
        <Label Content="Tên khoa:" HorizontalAlignment="Left" Height="40" Margin="748,256,0,0" VerticalAlignment="Top" Width="114" Foreground="Black"/>
        <Label Content="Triệu chứng:" HorizontalAlignment="Left" Height="36" Margin="745,327,0,0" VerticalAlignment="Top" Width="129" Foreground="Black"/>
        <Label Content="Bác sĩ:" HorizontalAlignment="Left" Height="38" Margin="765,403,0,0" VerticalAlignment="Top" Width="77" Foreground="Black"/>
        <Label Content="Kết quả:" HorizontalAlignment="Left" Height="37" Margin="762,486,0,0" VerticalAlignment="Top" Width="98" Foreground="Black"/>

        <TextBox x:Name="MaPhieuTxtLK" HorizontalAlignment="Left" Height="43" Margin="902,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="132"/>
        <TextBox x:Name="MaBenhNhanTxtLK" HorizontalAlignment="Left" Height="32" Margin="901,66,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="NgayKhamTxtLK" HorizontalAlignment="Left" Height="32" Margin="901,126,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="BuoiKhamTxtLK" HorizontalAlignment="Left" Height="32" Margin="901,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="TenKhoaTxtLK" HorizontalAlignment="Left" Height="32" Margin="901,254,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="TrieuChungTxtLK" HorizontalAlignment="Left" Height="60" Margin="904,317,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="BacSiTxtLK" HorizontalAlignment="Left" Height="32" Margin="905,409,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>
        <TextBox x:Name="KetQuaTxtLK" HorizontalAlignment="Left" Height="60" Margin="904,470,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="461"/>




    </Grid>
</UserControl>
